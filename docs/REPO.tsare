# docs/REPO.tsare -- the repository describing what it promises, and what checks it.
#
# The code is one kind of claim.  Everything else in the repository also claims something
# about the code, and each of those claims has a checker or it does not.
#
#     tsare check docs/REPO.tsare

layer L_REPO {
  name: "the repository itself",
  exposes: [P_EVERY_CLAIM_HAS_A_CHECKER]
}

# --- what the repository claims ------------------------------------------------------------

fact F_PROTOCOL {
  claim: "PROTOCOL.md fixes every command, its options and its JSON",
  evidence: doc("docs/PROTOCOL.md"),
  scope: "every command tsare implements",
  over: [L_COMMANDS],
  attrs: { checker: automated }
}

fact F_GOLDENS {
  claim: "crates/tsare/tests/golden.rs pins the exact text of every command on six documents",
  evidence: code("crates/tsare/tests/golden.rs"),
  scope: "the six fixture documents",
  over: [L_GOLDENS],
  attrs: { checker: automated }
}

fact F_EXPLAIN {
  claim: "every diagnostic code has an explanation, and a test fails when one is missing",
  evidence: code("crates/tsare-lang/src/explain.rs"),
  scope: "every code the compiler can print",
  over: [L_CODES],
  attrs: { checker: automated }
}

fact F_CI {
  claim: "continuous integration runs formatting, clippy as errors, the tests, and compiles the examples and SELF.tsare on three platforms",
  evidence: code(".github/workflows/ci.yml"),
  attrs: { checker: automated }
}

fact F_SELF {
  claim: "SELF.tsare compiles with no error and its concept learns a clause, or the test fails",
  evidence: code("crates/tsare/tests/semantics/main.rs"),
  attrs: { checker: automated }
}

fact F_ZERO_DEPENDENCIES {
  claim: "the crate has no dependencies, so the binary needs no runtime beyond the OS",
  evidence: code("crates/tsare/Cargo.toml"),
  attrs: { checker: automated }
}

fact F_EXAMPLES {
  claim: "the smallest fixture document compiles with no diagnostic at all",
  evidence: doc("crates/tsare/tests/fixtures/hello.tsare")
}

concept C_PROOF_CARRIER {
  name: "an artifact that carries a checkable claim about the code",
  grounded_by: [F_PROTOCOL, F_GOLDENS, F_EXPLAIN, F_CI, F_SELF, F_ZERO_DEPENDENCIES, F_INVENTORY],
  against: [F_README_IS_PROSE]
}

partition E_CLAIMS {
  dimension: C_PROOF_CARRIER,
  elements: [F_PROTOCOL, F_GOLDENS, F_EXPLAIN, F_CI, F_SELF, F_ZERO_DEPENDENCIES, F_INVENTORY],
  closure: closed,
  basis: [F_EXAMPLES]
}

proposition P_EVERY_CLAIM_HAS_A_CHECKER {
  statement: "each artifact that claims something about the code is accompanied by the thing that would fail if the claim were false",
  from: [F_PROTOCOL, F_GOLDENS, F_EXPLAIN, F_CI, F_SELF, F_ZERO_DEPENDENCIES, F_INVENTORY],
  over: [E_CLAIMS]
}

warrant W_EVERY_CLAIM_HAS_A_CHECKER {
  claim: "the list is closed over the artifacts the repository ships, and every element names its checker",
  from: [F_PROTOCOL, F_GOLDENS, F_EXPLAIN, F_CI, F_SELF, F_ZERO_DEPENDENCIES, F_INVENTORY],
  to: P_EVERY_CLAIM_HAS_A_CHECKER,
  basis: [F_EXAMPLES]
}

law L_REPO_HONEST {
  statement: "a document, a test or a workflow is part of this repository only when something fails as soon as it stops being true",
  holds_in: L_REPO,
  checked_by: [P_EVERY_CLAIM_HAS_A_CHECKER]
}

fact F_INVENTORY {
  claim: "the inventory block below is what `tsare inventory` prints, and a test fails when it drifts",
  evidence: code("crates/tsare/tests/inventory.rs"),
  attrs: { checker: automated }
}

# The layer below implements what L_REPO's promise hides: the extents the claims range over are
# produced by the build, and the codes they name are counted by a test.
law L_INVENTORY_IS_LIVE {
  statement: "the extents this repository's own claims range over are produced by the build, so a claim cannot outlive the commands and codes it names",
  holds_in: L_COMMANDS,
  refines: L_REPO,
  checked_by: [F_INVENTORY, V_CODES_EXPLAINED]
}

value V_CODES_EXPLAINED {
  metric: "diagnostic_codes_with_an_explanation",
  direction: min,
  unit: "fraction",
  threshold: 1,
  measured_by: "cargo test --release"
}

# --- what is not checked ------------------------------------------------------------------

fact F_README_IS_PROSE {
  claim: "the README's prose is not compiled; only the transcript in it is real output",
  evidence: doc("README.md"),
  attrs: { checker: none }
}

fact F_COMMITS_ARE_PROSE {
  claim: "commit messages are not checked against the diff",
  evidence: code("CONTRIBUTING.md")
}

blindspot B_PROSE_UNCHECKED {
  cannot_express: "a sentence in the README that is no longer true, when no diagnostic points at it",
  witness: [F_README_IS_PROSE, F_COMMITS_ARE_PROSE],
  signature: [C_PROOF_CARRIER],
  closes_with: [Q_READ_ME]
}

question Q_READ_ME {
  asks: "should the README be a compiled document too, or stay prose?",
  answers: ["compile the parts that make claims", "keep it prose and accept the drift"],
  separates: [H_COMPILE_README, H_KEEP_PROSE]
}

hypothesis H_COMPILE_README {
  assumes: [F_README_IS_PROSE],
  predicts: "the claims in the README can be written as declarations and checked like the rest",
  test: "write docs/README.tsare, compile it, and compare with the prose"
}

hypothesis H_KEEP_PROSE {
  assumes: [F_README_IS_PROSE, F_COMMITS_ARE_PROSE],
  predicts: "prose that nobody checks still earns its place by being read, and compiling it would cost more than it pays",
  rival: H_COMPILE_README
}

# --- inventory: generated by `tsare inventory`; do not edit by hand ---
#
# The extents three universal claims range over: the commands this build dispatches,
# the diagnostic codes it can print, and the documents the golden suite pins.

layer L_COMMANDS {
  name: "the commands this build dispatches",
  exposes: [F_CMD_ABSTRACT, F_CMD_APPLY, F_CMD_ARGUE, F_CMD_ARROWS, F_CMD_ASK, F_CMD_ASSUMPTIONS, F_CMD_AUDIT, F_CMD_BLAME, F_CMD_BUILD, F_CMD_CAT, F_CMD_CHAIN, F_CMD_CHAINS, F_CMD_CHECK, F_CMD_CONFRONT, F_CMD_CONTRACTS, F_CMD_COST, F_CMD_DEBT, F_CMD_DECIDE, F_CMD_DELTA, F_CMD_DERIVE, F_CMD_DIFF, F_CMD_EGRAPH, F_CMD_ENGINE, F_CMD_EPISTEMIC, F_CMD_EXTRACT, F_CMD_FCA, F_CMD_FIX, F_CMD_FMT, F_CMD_GRAPH, F_CMD_GROW, F_CMD_HINT, F_CMD_IMPACT, F_CMD_IMPLY, F_CMD_INDUCE, F_CMD_INVENTORY, F_CMD_KINDS, F_CMD_LIBRARY, F_CMD_LOG, F_CMD_MAP, F_CMD_MCP, F_CMD_MEET, F_CMD_MEM, F_CMD_MERGE, F_CMD_MOVES, F_CMD_NEXT, F_CMD_NOVEL, F_CMD_OUTLINE, F_CMD_PATTERN, F_CMD_PROJECT, F_CMD_PROPOSE, F_CMD_PROVENANCE, F_CMD_REPLAY, F_CMD_RESTORE, F_CMD_RETRACT, F_CMD_SAVE, F_CMD_SHAPE, F_CMD_STATUS, F_CMD_SUGGEST, F_CMD_TRACE, F_CMD_VIEWS, F_CMD_WEIGH, F_CMD_WHATIF]
