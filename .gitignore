# Default deny: a file is tracked only if a line below names it.
#
# The rule is one sentence: **tracked iff the build, the tests or the published package need
# it.** Prose, rounds of documents, experiment harnesses and their results stay on disk and in
# history, not in the tree.
#
# `/*` ignores the top level only.  That is deliberate: `*` would also ignore `src/check/`, and
# git never descends into an ignored directory, so a new file two levels down would vanish
# instead of showing up as untracked.  The `.github/workflows/ci.yml` step `git status
# --porcelain` catches additions under an allowed tree; nothing can catch a file that git was
# told not to look at.
/*
!/.gitattributes
!/.gitignore
!/.editorconfig
!/rustfmt.toml

!/.cargo
!/.github
!/src
!/tests

!/Cargo.toml
!/Cargo.lock

# The package front page and its licence, plus the documents code or tests read.
!/LICENSE
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SELF.tsare
!/docs

# Inside docs/, only the two files a test or a code comment points at.
/docs/*
!/docs/PROTOCOL.md
!/docs/REPO.tsare

# The prelude: what this project admits, compiled and tested.  Provisional, not decorative --
# `tests/prelude.rs` fails if the kernel stops refusing the document that violates it.
!/prelude
/prelude/*
!/prelude/*.tsare

# The skill is part of the artifact: without it a clone cannot be installed into a harness.
!/dsh
/dsh/*
!/dsh/tsare
/dsh/tsare/*
!/dsh/tsare/SKILL.md

# Junk, wherever it appears.
__pycache__/
*.pyc
.venv/
*.net.mmd
target/
.tsare/
.DS_Store
Thumbs.db

# The loop integration: without it a clone can install the skill but not the gate that makes the
# skill non-optional.
!/dsh/tsare-gate
/dsh/tsare-gate/*
!/dsh/tsare-gate/package.json
!/dsh/tsare-gate/index.js
!/dsh/tsare-gate/selftest.mjs
!/dsh/tsare-gate/verify-real.mjs
!/dsh/tsare-gate/fake-tsare.mjs
!/dsh/tsare-gate/README.md
!/dsh/tsare-gate/cordis.patch.yml
