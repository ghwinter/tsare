# Default deny: a file is tracked only if a line below names it, so adding a top-level
# directory means adding a line here.  git will not remind you -- .github/workflows/ci.yml
# runs `git status --porcelain` and fails on anything that is neither committed nor ignored.
*
!*/

!.gitattributes
!.gitignore
!.editorconfig
!rustfmt.toml

!LICENSE
!README.md
!CHANGELOG.md
!CONTRIBUTING.md
!Cargo.toml
!Cargo.lock
!SELF.mf

!.cargo/
!.cargo/**
!.github/
!.github/**

!src/
!src/**
!tests/
!tests/**
!docs/
!docs/**
!examples/
!examples/**
!agent/
!agent/**
!dsh/
!dsh/**
!experiments/
!experiments/**
!scripts/
!scripts/**

# What the allowlist above would otherwise let through.
__pycache__/
*.pyc
.venv/
target/
.DS_Store
Thumbs.db
