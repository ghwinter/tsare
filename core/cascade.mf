# Attack propagation: the rule survives, the premise does not.
#
# W_LINK is never attacked, so `argue` calls P_B supported.  But W_LINK's only premise is
# P_A, and P_A's only rule is defeated by W_BAD.  `engine` therefore refuses to fire W_LINK
# and calls P_B conditional.  The attack reached the conclusion through the premise.

fact F_TRACE { claim: "the trace is clean at 60 fps", evidence: tool("trace") }

proposition P_A {
  statement: "frame times never exceed 16 ms",
  from: [F_TRACE],
}

proposition P_NOISE {
  statement: "the trace has sampling gaps",
  from: [F_TRACE],
}

proposition P_B {
  statement: "the user perceives smooth scrolling",
  from: [P_A],
}

warrant W_GOOD {
  claim: "a clean trace means the frame budget holds",
  from: [F_TRACE],
  to: P_A,
  basis: [F_TRACE],
}

warrant W_BAD {
  claim: "sampling gaps make the clean trace uninformative",
  from: [F_TRACE],
  to: P_NOISE,
  basis: [F_TRACE],
  attacks: [W_GOOD],
}

warrant W_LINK {
  claim: "a met frame budget is what smoothness means",
  from: [P_A],
  to: P_B,
  basis: [F_TRACE],
}
